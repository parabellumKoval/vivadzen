APP_NAME=Vivadzen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── MySQL (shared контейнер, изолированная БД kratom) ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kratom
DB_USERNAME=kratom
DB_PASSWORD=kratom_secret

# ── Redis: source of read-truth для фронта ──
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Загрузка картинок (галерея товара + WYSIWYG) ──
# local  — на диск public (storage/app/public, отдача через /storage)
# bunny  — в BunnyCDN Storage, отдача через pull-zone
MEDIA_DRIVER=local
MEDIA_IMAGE_MAX_KB=10240

# BunnyCDN Storage Zone (заполнить если MEDIA_DRIVER=bunny)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_PULL_ZONE=https://your-zone.b-cdn.net

# ── Octane / FrankenPHP ──
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# ── Sanctum (для админ-API из Nuxt) ──
SANCTUM_STATEFUL_DOMAINS=localhost:3002
SESSION_DOMAIN=null
ADMIN_FRONT_URL=http://localhost:3002

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vivadzen.cz"
MAIL_FROM_NAME="${APP_NAME}"

# ── Search (Laravel Scout + Meilisearch) ──
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# ── Social login (Socialite) ──
# Заполните ключами из консолей Google / Facebook. redirect URI должен
# совпадать с тем, что зарегистрирован у провайдера.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

VITE_APP_NAME="${APP_NAME}"
