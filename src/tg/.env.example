NUXT_PUBLIC_SITE_URL=https://telegram-mini-app.example.com
NUXT_PUBLIC_API_BASE=https://api.example.com/api
NUXT_PUBLIC_STOREFRONT_CODE=main
# Optional: extra remote image host when product photos live on a CDN.
# NUXT_PUBLIC_IMAGE_CDN=https://cdn.example.com

# Optional: scope catalog tree to a sub-category (defaults to id 118 / slug "basic")
# NUXT_PUBLIC_TG_BASE_CATEGORY_ID=118
NUXT_PUBLIC_TG_BASE_CATEGORY_SLUG=basic

# Optional: per-category vibe tile config on the home page.
# Maps a category slug (as returned by the API) to { tag, icon, bg, label? }.
# - icon: any name supported by components/ui/TgIcon.vue (leaf, mushroom, sparkles, flame, heart, tag, box, package, star, ...)
# - bg:   one of: lime | magenta | accent | primary | yellow | white
# - tag:  short uppercase tagline shown above the icon (optional)
# - label: overrides the tile label; falls back to the category name from the API
# If a category slug has no entry, no vibe tile is rendered for it.
# NUXT_PUBLIC_TG_HOME_VIBES='{"muhomory":{"tag":"AMANITA","icon":"mushroom","bg":"magenta"},"kanabis":{"tag":"GREEN","icon":"leaf","bg":"primary"},"kava-kava":{"tag":"CHILL","icon":"heart","bg":"yellow"},"kanna":{"tag":"MOOD","icon":"sparkles","bg":"lime"},"akuamma":{"tag":"RELIEF","icon":"shield","bg":"white"},"kaapi":{"tag":"VINE","icon":"globe","bg":"accent"},"gavayskaya-roza":{"tag":"ROSE","icon":"flame","bg":"magenta"},"koridalis":{"tag":"CALM","icon":"circle","bg":"primary"}}'
